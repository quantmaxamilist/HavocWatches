---
// Renders verbatim product description blocks: headings, lists, "Label: value" spec rows, paragraphs.
import type { Block } from '../data/site';
interface Props { blocks: Block[] }
const { blocks } = Astro.props;
type G = { k: 'h' | 'p' | 'ul' | 'spec'; items: string[] };
const isSpec = (x: string) => /^[A-Z0-9][A-Za-z0-9 ()/-]{1,40}:\s+\S/.test(x) && x.length < 140;
const groups: G[] = [];
for (const b of blocks) {
  const last = groups[groups.length - 1];
  if (b.t === 'h') groups.push({ k: 'h', items: [b.x] });
  else if (b.t === 'li') last?.k === 'ul' ? last.items.push(b.x) : groups.push({ k: 'ul', items: [b.x] });
  else if (isSpec(b.x)) last?.k === 'spec' ? last.items.push(b.x) : groups.push({ k: 'spec', items: [b.x] });
  else groups.push({ k: 'p', items: [b.x] });
}
// a lone spec-looking line between paragraphs reads better as a paragraph
groups.forEach((g, i) => { if (g.k === 'spec' && g.items.length === 1 && groups[i - 1]?.k !== 'h') g.k = 'p'; });
---
<div class="blocks">
  {groups.map((g) => {
    if (g.k === 'h') return <h3 class="label red blocks__h">{g.items[0]}</h3>;
    if (g.k === 'ul') return <ul class="blocks__ul">{g.items.map((x) => <li>{x}</li>)}</ul>;
    if (g.k === 'spec') return (
      <dl class="blocks__spec">{g.items.map((x) => { const i = x.indexOf(':'); return <div><dt>{x.slice(0, i)}</dt><dd>{x.slice(i + 1).trim()}</dd></div>; })}</dl>
    );
    return <p>{g.items[0]}</p>;
  })}
</div>
<style>
  .blocks { display: grid; gap: 16px; }
  .blocks__h { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line-light); }
  .blocks__h:first-child { margin-top: 0; }
  .blocks__ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }
  .blocks__ul li::marker { color: var(--red); }
  .blocks__spec { margin: 0; display: grid; border-top: 1px solid var(--line-light); }
  .blocks__spec div { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line-light); }
  .blocks__spec dt { font: 500 0.8rem/1.4 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-on-light); }
  .blocks__spec dd { margin: 0; font-weight: 600; }
</style>
