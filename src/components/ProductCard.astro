---
import { price, catLabel, imgSize, type Product } from '../data/site';
interface Props { p: Product; eager?: boolean; sizes?: string }
const { p, eager = false, sizes = '(min-width: 1100px) 25vw, (min-width: 640px) 33vw, 50vw' } = Astro.props;
const [a, b] = p.images;
const [w, h] = imgSize(a);
---
<a href={`/product/${p.slug}`} class="pc" data-cats={p.cats.join(' ')}>
  <div class="ph pc__media no-shade">
    <img src={a} alt={p.name} width={w} height={h} loading={eager ? 'eager' : 'lazy'} decoding="async" sizes={sizes} />
    {b && <img class="pc__alt" src={b} alt="" width={imgSize(b)[0]} height={imgSize(b)[1]} loading="lazy" decoding="async" />}
  </div>
  <div class="pc__meta">
    <p class="label pc__cat">{catLabel(p)}</p>
    <h3 class="pc__name">{p.name}</h3>
    <p class="pc__price">{price(p.price)}</p>
  </div>
</a>
<style>
  .pc { display: block; text-decoration: none; color: inherit; }
  .pc__media { aspect-ratio: 2 / 3; background: var(--char); }
  .pc__media img { position: absolute; inset: 0; }
  .pc__alt { opacity: 0; transition: opacity 0.5s var(--ease), transform 1.1s var(--ease) !important; }
  @media (hover: hover) { .pc:hover .pc__alt { opacity: 1; } }
  .pc__meta { padding-top: 14px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: baseline; }
  .pc__cat { grid-column: 1 / -1; color: var(--red-hot); }
  :global(.light) .pc__cat, :global(.paper) .pc__cat { color: var(--red); }
  .pc__name { font: 700 clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem)/1.25 var(--f-text); }
  .pc__price { font: 500 0.95rem/1 var(--f-mono); }
  .pc:hover .pc__name { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
</style>
