---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { story, founder, seo } from '../data/site';
---
<Base title={seo['our-story'].title} description={story.intro}>
  <section class="st-hero dark">
    <div class="wrap st-hero__grid">
      <div class="st-hero__copy">
        <nav aria-label="Breadcrumb" class="crumbs label"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{story.title}</span></nav>
        <h1 class="display fs-hero">{story.title}</h1>
        <p class="statement">{story.intro}</p>
      </div>
      <figure class="st-hero__photo">
        <img src={founder.photo.src} alt={founder.photo.alt} width={founder.photo.w} height={founder.photo.h} fetchpriority="high" />
        <figcaption class="label muted">{founder.name} — {founder.role}</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec paper">
    <div class="wrap st-grid">
      <h2 class="display fs-d3" data-reveal>{story.h1}<br /><span class="red">{story.h2}</span></h2>
      <div class="st-body">{story.p.map((x, i) => <p class:list={{ lede: i === 0 }} data-reveal>{x}</p>)}</div>
    </div>
  </section>

  <section class="sec dark st-mid">
    <Mark class="st-mid__mark" />
    <div class="wrap st-grid">
      <h2 class="display fs-d3" data-reveal>{story.midTitle1}<br /><span class="red">{story.midTitle2}</span></h2>
      <div class="st-body">{story.p2.map((x) => <p data-reveal>{x}</p>)}</div>
    </div>
  </section>

  <section class="sec light st-close">
    <div class="wrap">
      <p class="display fs-d2" data-reveal>{story.close1}</p>
      <p class="statement st-close__p" data-reveal>{story.close2}</p>
      <div class="st-close__ctas" data-reveal>
        <a href="/shop" class="btn">Visit store <Icon name="arrow" /></a>
        <a href="/havoc-bespoke" class="btn btn--ghost">Havoc Bespoke</a>
      </div>
    </div>
  </section>
  <EnquiryBand />
</Base>
<style>
  .st-hero { padding: calc(var(--hdr) + clamp(40px, 6vw, 88px)) 0 clamp(56px, 7vw, 100px); background: radial-gradient(55% 70% at 85% 30%, rgba(159, 30, 33, 0.25), transparent 70%), var(--black); }
  .st-hero__grid { display: grid; gap: 40px; align-items: end; }
  .st-hero__copy { display: grid; gap: 22px; }
  .st-hero__copy .statement { max-width: 34ch; }
  .crumbs { display: flex; gap: 8px; color: var(--muted-on-dark); }
  .crumbs a { text-decoration: none; }
  .st-hero__photo { max-width: 380px; display: grid; gap: 10px; }
  @media (min-width: 960px) { .st-hero__grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 72px; } .st-hero__photo { justify-self: end; } }
  .st-grid { display: grid; gap: 28px; }
  .st-body { display: grid; gap: 18px; max-width: 64ch; }
  @media (min-width: 960px) { .st-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: 72px; } }
  .st-mid { overflow: hidden; }
  .st-mid__mark { position: absolute; left: -6%; bottom: -20%; width: min(50vw, 560px); color: rgba(159, 30, 33, 0.14); }
  .st-mid .st-grid { position: relative; }
  .st-mid .st-body { color: var(--muted-on-dark); }
  .st-close .fs-d2 { max-width: 18ch; }
  .st-close__p { margin-top: 20px; max-width: 40ch; }
  .st-close__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
</style>
