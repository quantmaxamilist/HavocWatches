---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Blocks from '../../components/Blocks.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { products, price, collections, features, contact, imgSize, type Product } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const col = collections.find((c) => c.slug === p.cats[0])!;
const feature = p.feature ? features.find((f) => f.slug === p.feature) : null;
const related = products.filter((x) => x.slug !== p.slug && x.cats.some((c) => p.cats.includes(c))).slice(0, 4);
const title = p.oldName !== p.name ? `${p.name} - Havoc Watches` : p.title;
const desc = p.short[0]?.x?.slice(0, 158) || p.meta;
const schema = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.name, brand: { '@type': 'Brand', name: 'HAVOC Watches' },
  image: p.images.map((i) => 'https://havocwatches.co.uk' + i), description: p.short.map((b) => b.x).join(' ').slice(0, 500),
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: p.price.toFixed(2), url: `https://havocwatches.co.uk/product/${p.slug}` },
};
---
<Base title={title} description={desc} image={p.images[0]} schema={schema}>
  <section class="pd dark">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="crumbs label">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/shop">Shop</a><span aria-hidden="true">/</span><a href={`/product-category/${col.slug}`}>{col.name}</a>
      </nav>
      <div class="pd__grid">
        <div class="gal" data-gal>
          <button class="ph gal__main no-shade" type="button" data-gal-open aria-label="Open photo gallery">
            <img src={p.images[0]} alt={p.name} width={imgSize(p.images[0])[0]} height={imgSize(p.images[0])[1]} fetchpriority="high" data-gal-main />
          </button>
          {p.images.length > 1 && (
            <div class="gal__thumbs" role="list">
              {p.images.map((src, i) => (
                <button type="button" class="ph gal__t no-shade" class:list={{ 'is-on': i === 0 }} data-gal-t={i} aria-label={`Photo ${i + 1} of ${p.images.length}`} role="listitem">
                  <img src={src} alt="" width={imgSize(src)[0]} height={imgSize(src)[1]} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="pd__info">
          <p class="label red">{col.name.toUpperCase()}</p>
          <h1 class="display fs-d2 pd__name">{p.name}</h1>
          <p class="pd__price">{price(p.price)}</p>
          <div class="pd__short">{p.short.map((b, i) => <p class:list={{ lede: i === 0 }}>{b.x}</p>)}</div>

          <form class="order" data-order data-name={p.name} data-price={price(p.price)}>
            {p.options.length > 0 && (
              <fieldset class="order__opts">
                <legend class="label">Colour</legend>
                <div class="swatches">
                  {p.options.map((o, i) => (
                    <label class="sw">
                      <input type="radio" name="colour" value={o.label} data-img={o.img} checked={i === 0} />
                      <span>{o.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            <label class="order__field">
              <span class="label">Personalisation <span class="muted">— enter up to 50 characters</span></span>
              <input type="text" name="personalisation" maxlength="50" autocomplete="off" />
            </label>
            <div class="order__btns">
              <button type="submit" class="btn" data-via="whatsapp"><Icon name="whatsapp" /> Order on WhatsApp</button>
              <button type="submit" class="btn btn--ghost" data-via="email"><Icon name="mail" /> Order by email</button>
            </div>
            <p class="order__note label muted">Or call <a href={contact.phoneHref}>{contact.phone}</a></p>
          </form>

          {feature && (
            <a href={`/${feature.slug}`} class="pd__feature">
              <span class="label muted">Feature</span>
              <span class="pd__feature-t">{feature.nav.filter(Boolean).join(' ')}</span>
              <Icon name="arrow" />
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {p.desc.length > 0 && (
    <section class="sec paper pd__details" aria-labelledby="details-h">
      <div class="wrap pd__dgrid">
        <h2 id="details-h" class="display fs-d3">Description</h2>
        <div class="measure"><Blocks blocks={p.desc} /></div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="sec light">
      <div class="wrap">
        <div class="rel__head">
          <h2 class="display fs-d3">{col.label}</h2>
          <a href={`/product-category/${col.slug}`} class="link-arrow">{col.cta} <Icon name="arrow" size={16} /></a>
        </div>
        <div class="rel__grid">{related.map((r) => <ProductCard p={r} />)}</div>
      </div>
    </section>
  )}

  <EnquiryBand />

  <dialog class="lb" data-lb aria-label={`${p.name} photos`}>
    <div class="lb__bar">
      <p class="label" data-lb-count></p>
      <button type="button" class="lb__x" data-lb-close aria-label="Close"><Icon name="close" size={24} /></button>
    </div>
    <img class="lb__img" src={p.images[0]} alt={p.name} data-lb-img />
    <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Previous photo"><Icon name="arrow" size={22} /></button>
    <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Next photo"><Icon name="arrow" size={22} /></button>
  </dialog>
  <script type="application/json" data-gal-data set:html={JSON.stringify(p.images)} />
</Base>

<style>
  .pd { padding: calc(var(--hdr) + 28px) 0 clamp(56px, 7vw, 100px); background: radial-gradient(50% 50% at 25% 40%, rgba(159, 30, 33, 0.2), transparent 70%), var(--black); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted-on-dark); margin-bottom: 24px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--text-on-dark); }
  .pd__grid { display: grid; gap: 40px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 980px) { .pd__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; align-items: start; } .pd__info { position: sticky; top: calc(var(--hdr) + 24px); } }
  .gal { display: grid; gap: 10px; }
  .gal__main { aspect-ratio: 2 / 3; width: 100%; max-height: 82vh; border: 0; padding: 0; cursor: zoom-in; background: var(--char); }
  .gal__main img { position: absolute; inset: 0; object-fit: cover; }
  .gal__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; }
  .gal__t { aspect-ratio: 1; border: 1px solid transparent; padding: 0; cursor: pointer; opacity: 0.6; transition: opacity 0.2s, border-color 0.2s; }
  .gal__t img { position: absolute; inset: 0; }
  .gal__t.is-on, .gal__t:hover { opacity: 1; border-color: var(--red-hot); }
  .pd__info { display: grid; gap: 18px; align-content: start; }
  .pd__name { overflow-wrap: anywhere; }
  .pd__price { font: 600 1.5rem/1 var(--f-mono); }
  .pd__short { display: grid; gap: 12px; color: var(--muted-on-dark); }
  .pd__short .lede { color: var(--text-on-dark); }
  .order { display: grid; gap: 18px; padding: 22px 0; border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); margin-top: 6px; }
  .order__opts { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .sw input { position: absolute; opacity: 0; pointer-events: none; }
  .sw span { display: inline-block; padding: 9px 12px; border: 1px solid var(--line-dark); font-size: 0.85rem; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .sw input:checked + span { border-color: var(--red-hot); background: rgba(159, 30, 33, 0.2); }
  .sw input:focus-visible + span { outline: 2px solid var(--red-hot); outline-offset: 2px; }
  .order__field { display: grid; gap: 8px; }
  .order__field input { font: inherit; color: inherit; background: var(--ink); border: 1px solid var(--line-dark); padding: 12px 14px; border-radius: var(--radius); }
  .order__field input:focus { outline: none; border-color: var(--red-hot); }
  .order__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .order__note a { color: var(--text-on-dark); }
  .pd__feature { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: center; padding: 18px; background: var(--ink); border: 1px solid var(--line-dark); text-decoration: none; }
  .pd__feature .label { grid-column: 1; }
  .pd__feature-t { grid-column: 1; font: 700 1.05rem/1.3 var(--f-text); }
  .pd__feature :global(svg) { grid-column: 2; grid-row: 1 / span 2; }
  .pd__feature:hover { border-color: var(--red-hot); }
  .pd__dgrid { display: grid; gap: 28px; }
  @media (min-width: 980px) { .pd__dgrid { grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr); gap: 72px; } }
  .rel__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .rel__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  @media (min-width: 1000px) { .rel__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* lightbox */
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(8, 8, 10, 0.97); color: var(--text-on-dark); }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: rgba(0, 0, 0, 0.8); }
  .lb__bar { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; }
  .lb__x, .lb__nav { background: none; border: 1px solid var(--line-dark); width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer; }
  .lb__img { max-width: min(92vw, 900px); max-height: 84dvh; width: auto; object-fit: contain; }
  .lb__nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(8, 8, 10, 0.6); }
  .lb__prev { left: 12px; }
  .lb__prev :global(svg) { transform: scaleX(-1); }
  .lb__next { right: 12px; }
</style>

<script>
  const data = document.querySelector('[data-gal-data]');
  const imgs: string[] = data ? JSON.parse(data.textContent || '[]') : [];
  const main = document.querySelector<HTMLImageElement>('[data-gal-main]');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gal-t]'));
  let idx = 0;
  const show = (i: number) => {
    idx = (i + imgs.length) % imgs.length;
    if (main) main.src = imgs[idx];
    thumbs.forEach((t, j) => t.classList.toggle('is-on', j === idx));
  };
  thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.galT))));

  // colour swatch swaps the main photo when that colour has its own photo
  document.querySelectorAll<HTMLInputElement>('input[name="colour"]').forEach((r) => r.addEventListener('change', () => {
    const src = r.dataset.img; if (!src || !main) return;
    const j = imgs.indexOf(src); j >= 0 ? show(j) : (main.src = src);
  }));

  // lightbox
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  const lbImg = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const lbCount = document.querySelector<HTMLElement>('[data-lb-count]');
  const lbShow = (i: number) => { idx = (i + imgs.length) % imgs.length; if (lbImg) lbImg.src = imgs[idx]; if (lbCount) lbCount.textContent = `Photo ${idx + 1} of ${imgs.length}`; };
  document.querySelector('[data-gal-open]')?.addEventListener('click', () => { if (!lb) return; lbShow(idx); lb.showModal(); (window as any).__lenis?.stop(); });
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => lb?.close());
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => lbShow(idx - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => lbShow(idx + 1));
  lb?.addEventListener('close', () => { (window as any).__lenis?.start(); show(idx); });
  lb?.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') lbShow(idx - 1); if (e.key === 'ArrowRight') lbShow(idx + 1); });
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

  // order: compose a WhatsApp / email message (the site has no checkout yet)
  const form = document.querySelector<HTMLFormElement>('[data-order]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const via = ((e as SubmitEvent).submitter as HTMLElement | null)?.dataset.via || 'whatsapp';
    const fd = new FormData(form);
    const lines = [`Order enquiry: ${form.dataset.name} (${form.dataset.price})`];
    if (fd.get('colour')) lines.push(`Colour: ${fd.get('colour')}`);
    const pers = String(fd.get('personalisation') || '').trim();
    if (pers) lines.push(`Personalisation: ${pers}`);
    lines.push(location.href);
    const msg = lines.join('\n');
    if (via === 'email') location.href = `mailto:havocwatches26@gmail.com?subject=${encodeURIComponent('Order enquiry: ' + form.dataset.name)}&body=${encodeURIComponent(msg)}`;
    else window.open(`https://wa.me/447362367694?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>
